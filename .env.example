APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This persistent app runs on Supabase Postgres. Prefer the direct Tokyo endpoint when
# the server has IPv6; otherwise use the Tokyo Session Pooler on port 5432. Do not use
# the transaction pooler on port 6543 for this runtime.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require
# Enable only after confirming the PHP worker count is below the Supabase pool limit.
DB_PERSISTENT=false

# Supabase Auth (GoTrue REST API) — Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only — bypasses all Supabase security rules (used for admin user provisioning). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=dental-clinic:
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache

TURBO_ENABLED=true
SLOW_REQUEST_THRESHOLD_MS=750

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="appointments@aquilizan.com"
MAIL_FROM_NAME="Aquilizan Dental Clinic"
SUPABASE_EMAIL_FUNCTION=send-transactional-email

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
